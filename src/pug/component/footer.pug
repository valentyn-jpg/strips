.propositions.wrapper 
    h2.middle-text Спеціальні пропозиції тижня
    p.small-text.footer-text Гарячі праозиції, по-швидше обирай і поїхали!
    .cards
        .card.star
            img(src="img/boat.jpg", alt="boat")
            h3.spesial-text Романтична подорож на 2
            p.tiny-text.p10 Подорож у найромантичніші <br>
                    | куточки світу, занурить вас у <br>
                    | дивовижні пейзажі природи.
            .inline.p10
                .price 2599 грн.
                .arrow.orange замовити
        .card.star
            .blue-bike
                img(src="img/bike.jpg", alt="biking")
                img(src="img/bicycle.png", alt="bike").bike
            h3.spesial-text Велотур
            p.tiny-text.p10 Бажаєте прокататись з вітерцем, та <br>
                        | ще й з критим краєвидом довкола? <br>
                        | Тоді швидше замовляй велотур!
            .inline.p10
                .price 555 грн.
                .arrow.orange замовити
        .card.star
            img(src="img/palm.jpg", alt="palm")
            h3.spesial-text На острови!
            p.tiny-text.p10 Хочеш зануритись у тишу, місце де <br>
                        | не має натовпу, та панує дмка <br>
                        | природа? Тоді вперед за пригодами!
            .inline.p10
                .price 1559 грн.
                .arrow.orange замовити
        .card.star
            img(src="img/surfing.jpg", alt="surfing")
            h3.spesial-text Катання на сьорфінгу
            p.tiny-text.p10 Хочеш отримати екстрим та мега <br>
                        | вражень одночасно? Тоді вперед <br>
                        |ловити хвилі!
            .inline.p10
                .price 999 грн.
                .arrow.orange замовити