
main
  section
    .wrapper.pricing
      .card.info
        h2.middle-text Про нашу компанію
        p.small-text.dark Наша компанія пропонує ряд цікавих та захоплюючих турів, які принесуть вам яскраві враження!
        a.submit(href="#") Детальніше
        p.tiny-text * - зверніть увагу, зміна ціни може залежати від курсу долара.

      .card
        img(src="img/biking.png")
        h3.spesial-text Тур на велосипедах
        .price 335 грн*
        p.tiny-text.grey Подорожуйте на велосипедах, відкриваючи неймовірні краєвиди.

      .card.star
        img(src="img/target.png")

        h3.spesial-text Екскурсія на острів
        .price 500 грн*
        p.tiny-text.grey Подорож на острів здивує вас чудовою природою. Неймовірна краса у будь-яку пору року.

      .card.star
        img(src="img/commet.png")
        h3.spesial-text Особливе замовлення
        .price 250 грн*
        p.tiny-text.grey Обираючи цю подорож, ви самостійно створюєте незабутню пригоду.
    
    .plans-link.wrapper
